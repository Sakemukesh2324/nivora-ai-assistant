{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile in NIVORA",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "photoURL": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["uid", "email"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "User conversation in NIVORA",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "pinned": { "type": "boolean" },
        "archived": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "title"]
    },
    "Project": {
      "title": "Project",
      "description": "User workspace project in NIVORA",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 1000 },
        "instructions": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "name"]
    },
    "FileDocument": {
      "title": "FileDocument",
      "description": "Uploaded or generated file metadata in NIVORA",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "projectId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "type": { "type": "string", "maxLength": 100 },
        "size": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "name"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile document"
    },
    "/users/{userId}/chats/{chatId}": {
      "schema": "Conversation",
      "description": "User conversation document"
    },
    "/users/{userId}/projects/{projectId}": {
      "schema": "Project",
      "description": "User project document"
    },
    "/users/{userId}/files/{fileId}": {
      "schema": "FileDocument",
      "description": "User file metadata document"
    }
  }
}
