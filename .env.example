# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# NIVORA AI Provider Configuration: "gemini", "openai", "claude", "groq", or "openrouter"
NIVORA_PRIMARY_PROVIDER="gemini"

# OpenAI API Key & Model
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.6-luna"

# Claude through LLMsRelay
LLMSRELAY_API_KEY=""
LLMSRELAY_MODEL="claude-sonnet-4.6"
LLMSRELAY_BASE_URL="https://api.llmsrelay.com/v1"

# Groq API Key & Model
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# OpenRouter API Key & Model
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct"

# Google Identity Services / OAuth Client ID
GOOGLE_CLIENT_ID=""
